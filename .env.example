# Copy to a secret manager or protected environment. Never commit real values.
APP_ENV=production
ENABLE_HSTS=1
ADMIN_UI_ENABLED=1
WAF_MODE=managed
# Production is fail-closed until these OIDC and external-store values are supplied.
# IAM_MODE=oidc
# PUBLIC_ORIGIN=https://app.example.jo
# OIDC_ISSUER_URL=https://identity.example.jo/realms/ezwatek
# OIDC_CLIENT_ID=ezwatek-web
# OIDC_ROLE_MAP=customer=ezwatek-customer,owner=ezwatek-owner,ops_manager=ezwatek-ops,security_auditor=ezwatek-security,support_lead=ezwatek-support
# OIDC_SCOPES=openid profile email groups
# OIDC_REQUIRED_AMR=webauthn,fido2,otp
# OIDC_REDIRECT_URI=https://app.example.jo/auth/callback
# OIDC_CLIENT_SECRET=inject-from-secret-manager-if-confidential-client
# DATA_BACKEND=postgres
# DATABASE_URL=postgresql://runtime:replace-me@postgres.internal:5432/ezwatek?sslmode=verify-full
# Or set PGSSLMODE=verify-full separately when the Secret Manager supplies the URL without query parameters.
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# ORDER_ADDRESS_ENCRYPTION_KEY=inject-base64url-32-byte-key-from-secret-manager
IAM_ADMIN_USERNAME=replace-me
IAM_ADMIN_PASSWORD_HASH=generate-with-python-scripts-bootstrap_iam.py
IAM_MFA_TOTP_SECRET=generate-with-python-scripts-bootstrap_iam.py
IAM_ADMIN_ROLES=owner
# For multi-instance production sessions, install requirements-production.txt:
# SESSION_STORE=redis
# RATE_LIMIT_STORE=redis
# REDIS_URL=rediss://:replace-me@redis.example.com:6380/0
# Redis Streams defaults: stream=ezwatek:jobs, group=ezwatek-workers
